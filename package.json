{
  "name": "intent-planner",
  "version": "0.29.1",
  "description": "A lightweight intent-planning layer for AI coding agents (Claude Code / Codex / Gemini CLI) that keeps implementation aligned with your product intent. Capture goals, invariants, and decision criteria before writing specs, hand them off to spec-driven workflows (kiro / cc-sdd / OpenSpec / Spec Kit), observe intent drift with warn-only checks, and write implementation learnings back into your intent documents. One-shot npx setup.",
  "type": "module",
  "author": "Yoshishige Tsuji <tsuji@coccole.biz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ijust/intent-planner.git"
  },
  "homepage": "https://github.com/ijust/intent-planner#readme",
  "bugs": {
    "url": "https://github.com/ijust/intent-planner/issues"
  },
  "bin": {
    "intent-planner": "bin/cli.mjs"
  },
  "files": [
    "templates",
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build-dist.mjs",
    "build:portable:windows": "node scripts/build-windows-portable.mjs",
    "preflight:portable:windows": "node scripts/preflight-windows-portable-release.mjs",
    "prepublishOnly": "node scripts/publish-check.mjs"
  },
  "dependencies": {
    "handoff-bridge": "0.2.2",
    "term-drift": "0.3.6"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "gemini",
    "gemini-cli",
    "agent-skills",
    "intent",
    "intent-planning",
    "steering",
    "ai-coding-agent",
    "spec-driven-development",
    "cc-sdd",
    "openspec",
    "speckit",
    "kiro",
    "refactoring",
    "ai-agents",
    "intent-drift",
    "semantic-drift",
    "agent-steering",
    "requirements-engineering",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@zip.js/zip.js": "2.8.34",
    "tar": "7.5.22"
  }
}
